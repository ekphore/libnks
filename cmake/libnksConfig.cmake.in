@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(_libnks_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(LibUSB)
set(CMAKE_MODULE_PATH "${_libnks_module_path}")
unset(_libnks_module_path)

include("${CMAKE_CURRENT_LIST_DIR}/libnksTargets.cmake")
check_required_components(libnks)
